// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/prisma-schema

// Looking for ways to speed up your queries, or scale easily on your serverless or edge functions?
// Try Prisma Accelerate: https://prisl.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/client"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                    String                 @id @default(cuid)
  business_name         String
  email                 String                 @unique
  phone_number          String                 @unique
  country               String
  settlement_currency   String
  webhook_url           String?
  webhook_secret        String
  /** Optional list of event types this merchant wants delivered. Empty = all events (backward-compatible). */
  webhook_subscribed_events String[]           @default([])
  password              String
  status                MerchantStatus         @default(pending_verification)
  api_key_hashed        String?
  api_key_last_four     String?
  settlement_schedule   String?                @default("daily")
  settlement_day        Int?
  /** FluxaPay fee percentage for this merchant (default 1.5%) */
  settlement_fee_percent Decimal               @default(1.5)
  /** HTTPS URL of logo shown on hosted checkout (/pay/:id). */
  checkout_logo_url     String?
  /** Primary accent for hosted checkout, e.g. #RRGGBB or #RGB. */
  checkout_accent_color String?
  /** Email notification preferences */
  email_notifications_enabled Boolean            @default(true)
  /// Email the merchant when a payment is confirmed. Exposed through
  /// PATCH /api/v1/merchants/me/notification-preferences (#1190).
  notify_on_payment     Boolean                @default(true)
  notify_on_settlement  Boolean                @default(true)
  /** On-chain registry state — prevents duplicate Soroban registrations on retry */
  onchain_registered        Boolean   @default(false)
  onchain_registry_tx_hash  String?
  /** Whether the merchant's phone number has been verified */
  verified_phone       Boolean                @default(false)
  /** Compliance: set when merchant requests account deletion */
  deletion_requested_at DateTime?
  /** Compliance: set after PII anonymization is complete */
  anonymized_at         DateTime?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  otps                  OTP[]
  settlements           Settlement[]
  kyc                   MerchantKYC?
  webhookLogs           WebhookLog[]
  payments              Payment[]
  refunds               Refund[]
  invoices              Invoice[]
  bankAccount           BankAccount?
  merchantHDDIndex       MerchantHDIndex?
  subscriptions         MerchantSubscription[]
  reconciliationRecords ReconciliationRecord[]
  discrepancyThresholds DiscrepancyThreshold[]
  discrepancyAlerts     DiscrepancyAlert[]
  customers             Customer[]
  dataExportJobs        DataExportJob[]
  paymentLinks          PaymentLink[]
  dailyReconciliationReports DailyReconciliationReport[]
  apiKeys               ApiKey[]
  refreshTokens            RefreshToken[]
  usagePeriods          MerchantUsagePeriod[]
}

model Customer {
  id              String   @id @default(cuid)
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId      String
  email           String
  name            String?
  phone           String?
  stellar_address String?
  metadata        Json     @default("{}")
  deleted_at       DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  payments        Payment[]
  paymentLinks    PaymentLink[]

  @@index([merchantId])
  @@index([merchantId, email])
  @@index([deleted_at])
  @@unique([merchantId, email])
}

model PaymentLink {
  id             String   @id @default(cuid)
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId      String
  slug           String   @unique
  title          String
  description    String?
  amount          Decimal?
  currency        String
  redirect_url    String?
  expiry          DateTime?
  active          Boolean  @default(true)
  metadata        Json     @default("{}")
  total_payments Int      @default(0)
  total_volume   Decimal  @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  payments        Payment[]
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([merchantId])
  @@index([slug])
  @@index([active])
  @@index([expiry])
}

model MerchantHDIndex {
  merchantId      String   @id
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  merchant_index  Int      @unique
  payment_counter Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model HDIndexCounter {
  id                  String   @id @default("global")
  next_merchant_index  Int      @default(0)
  updated_at           DateTime @updatedAt
}

model ManualIntervention {
  id          String   @id @default(cuid)
  merchantId  String
  issue_type  String
  description String
  status      String   @default("pending")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model BankAccount {
  id             String   @id @default(cuid)
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  merchantId      String   @unique
  account_name    String
  account_number  String
  bank_name       String
  bank_code       String?
  currency        String
  country         String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Plan {
  id                      String                 @id @default(cuid)
  name                    String
  slug                    String                 @unique
  description             String?
  amount                  Decimal
  currency                String
  interval                String                 // monthly, yearly
  is_active               Boolean                @default(true)
  /** Monthly API call quota (null = unlimited) */
  api_call_limit          Int?
  /** Monthly charge creation quota (null = unlimited) */
  charge_limit            Int?
  /** Monthly settlement volume quota in USDC (null = unlimited) */
  settlement_volume_limit Decimal?
  /** hard_block | soft_overage */
  overage_mode            String                 @default("hard_block")
  /** Feature flags, e.g. ["data_export_pii"] */
  features                Json                   @default("[]")
  /** Max payment expiry window in seconds (also used as plan default expiry) */
  max_payment_expiry_seconds Int?
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt
  subscriptions           MerchantSubscription[]
}

/// Per-merchant usage counters for the current billing period.
model MerchantUsagePeriod {
  id                 String   @id @default(cuid)
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId         String
  period_start       DateTime
  period_end         DateTime
  api_calls          Int      @default(0)
  charges_created    Int      @default(0)
  settlement_volume  Decimal  @default(0)
  warning_80_sent_at DateTime?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([merchantId, period_start])
  @@index([merchantId])
}

model MerchantSubscription {
  id                   String   @id @default(cuid)
  merchant             Merchant @relation(fields: [merchantId], references: [id])
  merchantId           String
  plan                 Plan     @relation(fields: [planId], references: [id])
  planId               String
  /// Status: 'active' or 'past_due' (grace period for failed renewal)
  status               String   @default("active")
  billing_cycle        String
  current_period_start DateTime
  current_period_end   DateTime
  next_billing_date    DateTime
  /** Plan amount actually charged/applied for the current period, captured
   *  fresh from Plan.amount at subscription creation and on every renewal. */
  current_period_amount        Decimal?
  /** Set once a price-increase notice email has been sent for the
   *  upcoming renewal, so the 7-day-prior notice job doesn't resend it. */
  price_change_notice_sent_at  DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model AuditLog {
  id          String          @id @default(cuid)
  admin_id    String
  action_type AuditActionType
  entity_type AuditEntityType
  entity_id   String
  details     Json
  created_at   DateTime        @default(now())

  @@index([admin_id, created_at(sort: Desc)])
  @@index([entity_id, action_type])
}

model OTP {
  id         String     @id @default(cuid)
  merchant   Merchant   @relation(fields: [merchantId], references: [id])
  merchantId String
  channel    OTPChannel
  code       String
  expires_at DateTime
  created_at DateTime   @default(now())

  @@unique([merchantId, channel])
}

model Settlement {
  id               String           @id @default(cuid)
  merchant         Merchant         @relation(fields: [merchantId], references: [id])
  merchantId       String
  usdc_amount      Decimal?
  amount           Decimal
  fees             Decimal
  net_amount        Decimal?
  currency         String
  status           SettlementStatus @default(pending)
  exchange_partner String?
  exchange_rate    Decimal?
  exchange_ref     String?
  bank_transfer_id String?
  breakdown        Json?
  payment_ids      Json?
  failure_reason   String?
  payout_partner_payload Json?
  scheduled_date   DateTime
  processed_date   DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  payments         Payment[]

  @@index([merchantId, status])
  @@index([merchantId, scheduled_date(sort: Desc)])
}

model MerchantKYC {
  id                           String           @id @default(cuid)
  merchant                     Merchant         @relation(fields: [merchantId], references: [id])
  merchantId                   String           @unique
  business_type                BusinessType
  legal_business_name          String
  business_registration_number String?
  country_of_registration      String
  business_address             String
  director_full_name           String
  director_email               String
  director_phone               String
  government_id_type           GovernmentIdType
  government_id_number         String
  kyc_status                   KYCStatus        @default(not_submitted)
  rejection_reason             String?
  reviewed_at                  DateTime?
  reviewed_by                  String?
  /** Set when documents expire without renewal; merchant flagged for compliance review. */
  flagged_for_review           Boolean          @default(false)
  flagged_for_review_at        DateTime?
  documents                    KYCDocument[]
  created_at                    DateTime         @default(now())
  updated_at                    DateTime         @updatedAt
}

model KYCDocument {
  id            String       @id @default(cuid)
  kyc           MerchantKYC  @relation(fields: [kycId], references: [id])
  kycId         String
  document_type DocumentType
  file_name     String
  file_url      String
  public_id     String
  file_size     Int
  mime_type     String
  /** Expiration date of the document (passport, national ID, certificate of incorporation, etc.). */
  document_expiry_date DateTime?
  /** Last renewal-reminder threshold (in days) sent for this document: 60, 30, or 7. */
  last_reminder_days Int?
  /** Timestamp of the most recent renewal reminder email sent for this document. */
  last_reminder_sent_at DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@index([kycId])
  @@index([document_expiry_date])
  @@index([document_expiry_date, last_reminder_days])
}
